{
  "name": "storage-planner",
  "version": "0.0.0",
  "private": true,
  "description": "Authenticated building, floor, and storage spot planner.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:login": "node scripts/dev-login.mjs",
    "dev:web": "next dev --webpack --port 3100",
    "dev:backend": "convex dev",
    "codegen": "convex codegen --typecheck disable",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:a11y": "vitest run --project a11y",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "dev:seed": "node scripts/seed-local-test.mjs"
  },
  "dependencies": {
    "@clerk/backend": "3.16.4",
    "@clerk/nextjs": "7.7.4",
    "@clerk/shared": "4.28.1",
    "@zxing/browser": "0.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "convex": "1.43.0",
    "lucide-react": "1.31.0",
    "motion": "13.4.0",
    "next": "16.3.3",
    "next-intl": "4.13.4",
    "next-themes": "0.4.6",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@edge-runtime/vm": "5.0.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "4.12.1",
    "convex-test": "0.0.54",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.9.0",
    "jest-axe": "11.0.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.17.0",
    "svix": "1.99.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
