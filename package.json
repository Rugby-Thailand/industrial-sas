{
  "name": "industrial-sas",
  "version": "0.0.0",
  "private": true,
  "description": "Mobile-first, multi-tenant B2B SaaS Warehouse Management System for Thai manufacturing companies.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --webpack",
    "dev:backend": "convex dev",
    "codegen": "convex codegen --typecheck disable",
    "measure:code": "node scripts/measure-code.mjs",
    "dev:check": "node scripts/check-development-setup.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "test:convex-runtime": "vitest run --project convex-runtime",
    "test:integration": "vitest run --project integration",
    "test:isolation": "vitest run --project isolation",
    "test:a11y": "vitest run --project a11y",
    "test:e2e": "node scripts/run-e2e.mjs",
    "verify:workflows": "node scripts/verify-workflows.mjs",
    "verify:tenant-boundary": "node scripts/verify-tenant-boundary.mjs",
    "verify:native-select": "node scripts/verify-native-select.mjs",
    "verify:environment": "node scripts/verify-environment.mjs",
    "verify:order-to-ship-3nf": "node scripts/verify-order-to-ship-3nf.mjs",
    "manual:assets": "node scripts/generate-operator-manual-assets.mjs",
    "manual:generate": "node scripts/generate-html-manual.mjs",
    "manual:build": "pnpm manual:assets && pnpm manual:generate",
    "manual:check": "node scripts/verify-manual.mjs",
    "manual:capture": "node scripts/capture-manual-targets.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "rehearse:restore": "node scripts/rehearse-restore.mjs",
    "guards": "pnpm verify:workflows && pnpm verify:tenant-boundary && pnpm verify:native-select && pnpm verify:environment && pnpm manual:build && pnpm manual:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm audit:prod"
  },
  "dependencies": {
    "@clerk/backend": "3.16.4",
    "@clerk/nextjs": "7.7.4",
    "@clerk/shared": "4.28.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "convex": "1.43.0",
    "lucide-react": "1.31.0",
    "next": "16.2.12",
    "next-intl": "4.13.4",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.17.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@edge-runtime/vm": "5.0.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "4.12.1",
    "convex-test": "0.0.54",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.9.0",
    "jest-axe": "11.0.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svix": "1.99.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
