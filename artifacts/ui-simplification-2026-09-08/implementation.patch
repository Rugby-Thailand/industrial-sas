+      </dl>
+      <p className="text-xs text-muted">
+        {tr(
+          "X/Y are measured from the marked origin inside this location.",
+          "พิกัด X/Y อ้างอิงจากจุดเริ่มต้นที่แสดงภายในจุดจัดเก็บนี้",
+        )}
+      </p>
+    </div>
+  );
+}
+export function PlacementEditor({
+  warehouseId,
+  detail,
+  candidate: initialCandidate,
+  destinations = [initialCandidate],
+  moving = false,
+  onReserved,
+  onActivate,
+}: {
+  warehouseId: string;
+  detail: PalletDetail;
+  candidate: Candidate;
+  destinations?: readonly Candidate[];
