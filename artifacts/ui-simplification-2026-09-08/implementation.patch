+        .filter((d) => d.zoneId === initialCandidate.zoneId)
+        .map((d) => ({
+          ...d.support,
+          supportPalletId: d.supportPalletId,
+          supportPositionId: d.supportPositionId,
+          supportCode: d.supportCode,
+        }));
