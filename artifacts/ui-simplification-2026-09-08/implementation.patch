+        <aside className={`${panel} space-y-4`}>
+          <h2 className="font-semibold">
+            {tr("Exact position", "ตำแหน่งที่แน่นอน")}
+          </h2>
+          {!moving && detail.pallet.status === "AWAITING_PLACEMENT" && (
+            <Link
+              onClick={onActivate}
