# Dependency versions are reviewed and pinned deliberately (decision D-29).
# Never let a save/add rewrite them into floating ranges.
save-exact=true
save-prefix=

# Fail fast when the local Node/pnpm version does not match "engines".
engine-strict=true

# Peer resolution: install declared peers, but surface conflicts as warnings so
# an intentional compatibility pin (for example TypeScript) does not block CI.
auto-install-peers=true
strict-peer-dependencies=false
dedupe-peer-dependents=true

# Reproducibility.
resolution-mode=highest
prefer-workspace-packages=true
