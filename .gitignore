# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# pnpm
.pnpm-store/
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Next.js / build output
# ---------------------------------------------------------------------------
.next/
# The Playwright preview dev server builds here (see playwright.config.ts).
.next-preview/
# End-to-end build directories, one per Playwright server. Kept distinct from
# `.next` and `.next-preview` so a suite never shares a manifest with a
# developer's own dev server (see `playwright.config.ts`).
.next-e2e/
.next-e2e-preview/
.next-storage-verify/
out/
build/
dist/
.turbo/
.swc/
*.tsbuildinfo
# `next-env.d.ts` is generated, and on Next 16 its contents depend on *which*
# command generated it: `next dev` writes `import "./.next/dev/types/routes.d.ts"`
# and `next build` writes `import "./.next/types/routes.d.ts"`. Tracking it meant
# whichever variant was committed churned the working tree the moment anyone ran
# the other command — and the `build` CI job, which runs `next build` and then
# asserts the tree is clean, could not pass at all while the committed copy was
# the `dev` one.
#
# It is safe to ignore because nothing depends on it: `tsconfig.json` already
# includes `.next/types/**` and `.next/dev/types/**` directly, and `pnpm
# typecheck` passes on a cold tree with no `.next` and no `next-env.d.ts` at all.
# `tests/integration/generated-artifacts.integration.test.ts` holds that line.
/next-env.d.ts

# ---------------------------------------------------------------------------
# Convex (local / generated)
# ---------------------------------------------------------------------------
.convex/
convex/_generated/

# ---------------------------------------------------------------------------
# Environment files — never commit real values
# ---------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.envrc
# Templates are intentionally tracked
!.env.example
!.env.*.example

