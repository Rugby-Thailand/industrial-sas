# Copy to .env.local. Never commit actual credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/th/sign-in
NEXT_PUBLIC_OBSERVABILITY_SINK=none
# Opt-in telemetry. Public DSN is a routing identifier, never an auth token.
# Speed Insights must be provisioned for the Vercel project before enabling.
NEXT_PUBLIC_SPEED_INSIGHTS_ENABLED=0
NEXT_PUBLIC_SENTRY_ENABLED=0
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENABLED=0
SENTRY_DSN=
# Server/build only; required for private source-map upload, never NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Written by the isolated local convex dev setup:
CONVEX_DEPLOYMENT=
# Set to 1 only in a local demo to return sample ticket fields without an AI key.
JOB_SCAN_DEMO_AI=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Vercel CI only: production Convex deploy credential, never a local dev key.
CONVEX_DEPLOY_KEY=
