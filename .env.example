# Copy to .env.local. Never commit actual credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/th/sign-in
NEXT_PUBLIC_OBSERVABILITY_SINK=none
# Written by the isolated local convex dev setup:
CONVEX_DEPLOYMENT=
# Set to 1 only in a local demo to return sample ticket fields without an AI key.
JOB_SCAN_DEMO_AI=
# Configure these on the Convex deployment; never expose the provider key to the browser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_SEARCH_MODEL=
# Explicitly distinguish local/staging/production in the AI ledger.
AI_USAGE_ENVIRONMENT=local
# Optional non-secret label for the provider billing account (not an API key).
AI_USAGE_BILLING_ACCOUNT_REF=default
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Vercel CI only: production Convex deploy credential, never a local dev key.
CONVEX_DEPLOY_KEY=
