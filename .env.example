# =============================================================================
# Industrial SAS — environment variable template
# =============================================================================
# Copy to `.env.local` and fill in per-environment values. NEVER commit a filled
# file: only this template is tracked. Values are intentionally blank here.
#
# Nothing in this file is required to run the current scaffold. `pnpm build`,
# `pnpm typecheck`, and `pnpm test` all pass with no `.env.local` present.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle. Never put a
# secret behind that prefix.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Absolute origin of this deployment, e.g. used for webhook callback URLs.
NEXT_PUBLIC_APP_URL=
# Selects the ObservabilityPort adapter (INT-05): "none" (default) or "console".
# Never a vendor DSN — this repository has no telemetry vendor configured, and a
# key here would be a credential in a browser bundle.
NEXT_PUBLIC_OBSERVABILITY_SINK=

# -----------------------------------------------------------------------------
# Convex (backend + inventory ledger)
# -----------------------------------------------------------------------------
# Public deployment URL used by the browser client.
NEXT_PUBLIC_CONVEX_URL=
# Deployment identifier written by `convex dev`; developer machines only.
CONVEX_DEPLOYMENT=
# CI/CD only. Secret. Grants deploy rights to a Convex deployment.
CONVEX_DEPLOY_KEY=

# -----------------------------------------------------------------------------
# Clerk (identity, MFA, sessions, organizations)
# -----------------------------------------------------------------------------
# Development uses Clerk test keys and the first-class Convex integration. The
# normal v2 session token supplies `aud=convex` and `o.id`; do not create a custom
# JWT template just to reproduce deprecated `org_id`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret. Server-side Clerk API access.
CLERK_SECRET_KEY=
# Secret. Clerk webhook signing secret. The pinned SDK verifies the compatible
# svix-* delivery headers before the payload reaches any Convex mutation.
CLERK_WEBHOOK_SIGNING_SECRET=
# Clerk JWT issuer domain. Also required as a Convex environment variable so
# Convex can validate Clerk-issued identity tokens.
CLERK_JWT_ISSUER_DOMAIN=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=

# -----------------------------------------------------------------------------
# UploadThing (private file storage)
# -----------------------------------------------------------------------------
# Secret. Must be issued for an app configured with private ACLs and
# short-lived signed URLs before any production use.
UPLOADTHING_TOKEN=

# -----------------------------------------------------------------------------
# Local tooling
# -----------------------------------------------------------------------------
# Port used by the Playwright-managed dev server. Defaults to 3100. The suite
# also starts a second dev server on PLAYWRIGHT_PORT + 1 for the preview-data
# journeys.
PLAYWRIGHT_PORT=
# Overrides the Next.js build directory. Used only by the Playwright preview
# server, which needs its own so two dev servers can run side by side.
NEXT_DIST_DIR=
