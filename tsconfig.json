{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // Mandated by `next build` on Next 16: the automatic React runtime is not
    // optional. Reverting this to "preserve" causes Next to rewrite this file.
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true,
    "incremental": true,
    "skipLibCheck": true,
    "types": ["node"],
    // No `baseUrl`: it is deprecated in TypeScript 6 and removed in 7. Without
    // it, `paths` resolve relative to this file, which is what we want.
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "types/**/*.d.ts",
    "**/*.ts",
    "**/*.mts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // `.next` is deliberately absent: `exclude` filters `include`, so excluding it
  // would drop the generated route types listed above.
  "exclude": ["node_modules", "out", "coverage", "playwright-report"]
}
