      "steps": [
        {
          "waitFor": "main ul li button"
        }
      ],
      "notes": "First screen of Scan job ticket: search, scan or photograph the storage location; first page of seeded locations listed."
    },
    {
      "id": "scan-location-camera",
      "title": "Location step with the live camera open",
      "state": "camera-live",
      "path": "/finished-goods/scan",
      "viewports": ["mobile"],
      "camera": "output/ui-loop/assets/camera-scene.y4m",
      "ready": "main h1",
      "steps": [
        {
          "click": {
            "role": "button",
            "name": {
              "th": "สแกนรหัส",
              "en": "Scan code"
            }
          }
        },
        {
          "waitFor": {
            "text": {
              "th": "เล็งกล้องไปที่บาร์โค้ดหรือ QR",
              "en": "Point the camera at a barcode"
            }
          }
        },
        {
          "wait": 1000
        }
      ],
      "notes": "Chromium fake camera plays a code-free pallet scene, so the viewfinder stays open (decoder timing and glare are not represented)."
    },
