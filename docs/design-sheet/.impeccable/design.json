      "html": "<div class=\"ds-field\"><label class=\"ds-label\" for=\"ds-job\"><span>Job number <span aria-hidden=\"true\">*</span></span><span class=\"ds-origin\">AI origin</span></label><input class=\"ds-input\" id=\"ds-job\" value=\"DEMO-FO-001\" required spellcheck=\"false\" autocomplete=\"off\" /><p class=\"ds-hint\">Review the extracted value before saving.</p></div>",
      "css": ".ds-field{min-width:0;font-family:var(--sheet-sans,Geist,\"Noto Sans Thai\",sans-serif);color:var(--token-text,oklch(0.205 0 0));}.ds-label{display:flex;align-items:baseline;gap:6px;margin-bottom:2px;font-size:12px;line-height:18px;font-weight:500;}.ds-origin{color:var(--token-warning,#8a5300);}.ds-input{box-sizing:border-box;min-height:36px;width:100%;min-width:0;padding:6px 10px;border:1px solid var(--token-border-strong,#808080);border-radius:6.4px;background:var(--token-surface,oklch(1 0 0));color:var(--token-text,oklch(0.205 0 0));caret-color:var(--token-link,oklch(0.4901 0.2875 264.3293));font-family:var(--sheet-mono,\"Geist Mono\",\"Noto Sans Thai\",monospace);font-size:14px;line-height:20px;}.ds-input:focus-visible{border-color:var(--ring,oklch(0.46 0.22 266));outline:2px solid var(--ring,oklch(0.46 0.22 266));outline-offset:-1px;}.ds-input[aria-invalid=\"true\"]{border-color:var(--token-danger,#b3261e);}.ds-hint{margin:8px 0 0;color:var(--token-muted,oklch(0.44 0 0));font-size:12px;line-height:18px;}@media(max-width:800px){.ds-input{min-height:48px;padding-block:10px;font-size:16px;line-height:24px;}}"
