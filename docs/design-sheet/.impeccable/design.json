      "description": "The next scoped action: 36px desktop and 48px at touch widths. This preview does not write records.",
      "html": "<button type=\"button\" class=\"ds-button\">Save changes</button>",
      "css": ".ds-button{min-height:36px;min-width:36px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:6px 12px;border:1px solid var(--token-primary-border,oklch(0.4901 0.2875 264.3293));border-radius:6.4px;background:var(--token-accent,oklch(0.4901 0.2875 264.3293));color:var(--token-accent-contrast,oklch(0.985 0 0));font-family:var(--sheet-sans,Geist,\"Noto Sans Thai\",sans-serif);font-size:14px;line-height:20px;font-weight:600;cursor:pointer;transition:background-color var(--sheet-duration,160ms),border-color var(--sheet-duration,160ms);}.ds-button:hover:not(:disabled){background:var(--token-accent-hover,#1024c4);}.ds-button:focus-visible{outline:2px solid var(--ring,oklch(0.46 0.22 266));outline-offset:2px;}.ds-button:active:not(:disabled){transform:translateY(1px);}.ds-button:disabled{cursor:not-allowed;background:var(--token-disabled-surface,oklch(0.97 0 0));border-color:var(--token-border,oklch(0.92 0 0));color:var(--token-disabled,oklch(0.44 0 0));}@media(prefers-reduced-motion:reduce){.ds-button{transition:none;}}@media(max-width:800px){.ds-button{min-height:48px;min-width:48px;padding:10px 16px;}}"
