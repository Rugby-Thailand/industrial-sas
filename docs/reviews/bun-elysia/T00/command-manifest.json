        "coverage": {
          "name": "Full-suite coverage",
          "needs": [],
          "timeoutMinutes": 30,
          "steps": [
            {
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1"
            },
            {
              "uses": "./.github/actions/setup-node-pnpm"
            },
            {
              "name": "Vitest with coverage",
              "run": "pnpm exec vitest run --coverage --coverage.reportOnFailure --testTimeout=15000 --reporter=default --reporter=github-actions --reporter=junit --outputFile.junit=test-results/vitest-junit.xml"
            },
            {
              "name": "Upload coverage and JUnit",
              "uses": "actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9"
            }
          ],
          "secretNames": [],
          "variableNames": []
        }
      }
    },
    "actions/setup-node-pnpm": {
      "steps": [
        {
          "name": "Validate inputs",
          "run": "case \"$CACHE_INPUT\" in true | false) ;; *) echo \"::error::setup-node-pnpm input cache must be true or false\"; exit 1 ;; esac"
        },
        {
          "name": "Install pnpm",
          "uses": "pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413"
        },
        {
          "name": "Install Node.js",
          "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
          "with": {
            "node-version-file": ".nvmrc",
            "cache": "${{ inputs.cache == 'true' && 'pnpm' || '' }}",
            "package-manager-cache": "${{ inputs.cache == 'true' }}"
          }
        },
        {
          "name": "Install dependencies",
          "run": "pnpm install --frozen-lockfile"
        }
      ]
    }
  }
}
